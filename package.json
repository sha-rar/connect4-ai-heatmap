{
  "name": "connect4",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev:web": "pnpm --filter @connect4/web dev",
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "build:wasm": "node scripts/build-wasm.mjs",
    "fixtures:games": "tsx scripts/generate-games.ts",
    "test": "pnpm -r test && vitest run",
    "test:reference": "vitest run",
    "test:e2e": "playwright test",
    "lint": "pnpm -r lint",
    "format": "prettier -w ."
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^25.0.9",
    "prettier": "^3.3.3",
    "tsx": "^4.21.0",
    "vitest": "^4.0.17"
  }
}
